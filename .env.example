# ============================================================
# KAIZEN TOOLBOX — Variables d'environnement
# Copier ce fichier en ".env", A COTE DE server-sqlserver.js,
# puis renseigner les valeurs.
#
# Le serveur relit ce fichier a chaque demarrage : apres toute
# modification, redemarrer l'application pour qu'elle prenne effet.
# Les valeurs de ce fichier l'emportent sur celles de l'environnement.
# ============================================================

# Nom ou IP du serveur SQL Server (ex: SRVPROD, 192.168.1.10, SRVPROD\SQLEXPRESS)
DB_SERVER=VOTRE_SERVEUR

# Nom de la base de donnees
DB_NAME=kaizen_toolbox

# Identifiant SQL Server
DB_USER=kaizen_user

# Mot de passe SQL Server
# Si le mot de passe contient un espace ou un « # », l'encadrer de guillemets :
# DB_PASSWORD="mon mot de passe"
DB_PASSWORD=VOTRE_MOT_DE_PASSE

# Port SQL Server (1433 par defaut)
DB_PORT=1433

# Port d'ecoute de l'application.
# Sous IIS, ne pas renseigner : l'hebergeur impose le point d'ecoute et
# cette valeur serait ignoree. Utile uniquement en lancement direct.
# PORT=3000

# ── Chat expert Lean ────────────────────────────────────────
# Cle de l'API d'intelligence artificielle utilisee par la chatbox.
# Laissee vide, la chatbox bascule sur son moteur local : elle continue
# d'orienter vers le bon outil et de retrouver les chantiers deja menes,
# mais sans reponse redigee.
ANTHROPIC_API_KEY=

# Modele utilise (facultatif). Valeur par defaut si absent.
# ANTHROPIC_MODEL=claude-sonnet-4-6
