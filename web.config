<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration IIS pour faire tourner Kaizen Toolbox sous iisnode.

  A deposer a la racine du site, a cote de server-sqlserver.js.
  Prerequis sur le serveur : Node.js, le module IIS "iisnode" et le module
  "URL Rewrite".

  Point d'attention : sous IIS, c'est l'hebergeur qui impose le port au
  processus Node (canal nomme). C'est pourquoi la variable PORT ne doit pas
  etre renseignee dans le fichier .env — le serveur la laisse volontairement
  passer depuis l'environnement.
-->
<configuration>
  <system.webServer>

    <!-- Le point d'entree de l'application est confie a iisnode. -->
    <handlers>
      <add name="iisnode" path="server-sqlserver.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Les traces d'iisnode ne passent pas par l'application. -->
        <rule name="iisnode-journaux" stopProcessing="true">
          <match url="^server-sqlserver.js\/debug[\/]?" />
        </rule>

        <!-- Les fichiers reellement presents sur le disque (pages, styles,
             scripts, trames SWM) sont servis directement par IIS : c'est plus
             rapide que de les faire transiter par Node. -->
        <rule name="fichiers-statiques" stopProcessing="true">
          <match url="^(css|js|templates)\/.*" />
          <action type="None" />
        </rule>

        <!-- Tout le reste part vers l'application Node. -->
        <rule name="application">
          <match url="/*" />
          <action type="Rewrite" url="server-sqlserver.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Le fichier .env porte le mot de passe SQL : il ne doit jamais etre
         servi en HTTP. Idem pour les fichiers de dependances. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="lib" />
          <add segment="data" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
        <!-- Les photos sont transmises en base64 dans le corps des requetes :
             la limite par defaut d'IIS (30 Mo) est conservee, mais la limite
             applicative est de 15 Mo (voir express.json dans le serveur). -->
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>

    <iisnode
      nodeProcessCountPerApplication="1"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false" />

    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
